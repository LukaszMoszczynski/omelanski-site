# Stara domena omelanska.com -> nowa strona https://omelanski.pl
# Wgrać jako ".htaccess" do katalogu głównego omelanska.com (Plesk: httpdocs/).
# Najpierw zrobić kopię obecnego .htaccess.
#
# Przekierowywane są tylko omelanska.com i www.omelanska.com. Warunek na host
# sprawia, że ekartoteka.omelanska.com (i każda inna subdomena) działa bez zmian,
# nawet gdyby korzystała z tego samego katalogu. Poczta @omelanska.com też bez zmian.

RewriteEngine On

# Stare podstrony -> odpowiadające nowe podstrony
RewriteCond %{HTTP_HOST} ^(www\.)?omelanska\.com$ [NC]
RewriteRule ^3-akty-prawne\.html$ https://omelanski.pl/akty-prawne/ [R=301,L,NC]

RewriteCond %{HTTP_HOST} ^(www\.)?omelanska\.com$ [NC]
RewriteRule ^4-oferta\.html$ https://omelanski.pl/oferta/ [R=301,L,NC]

RewriteCond %{HTTP_HOST} ^(www\.)?omelanska\.com$ [NC]
RewriteRule ^k-kontakt\.html$ https://omelanski.pl/kontakt/ [R=301,L,NC]

RewriteCond %{HTTP_HOST} ^(www\.)?omelanska\.com$ [NC]
RewriteRule ^38-rodo\.html$ https://omelanski.pl/rodo/ [R=301,L,NC]

# Wszystko inne (strona główna, 2-o-nas.html, stare pliki) -> nowa strona główna
RewriteCond %{HTTP_HOST} ^(www\.)?omelanska\.com$ [NC]
RewriteRule ^ https://omelanski.pl/ [R=301,L]
