---
import { BUSINESS } from '../data/site';
import Logo from './Logo.astro';

// The wordmark follows the printed logo: tagline, colour bar, name — set in the
// logo's own typeface (--font-brand) so the site's serif never touches the brand.
interface Props { stacked?: boolean; class?: string }
const { stacked = false, class: className } = Astro.props;
---
<span class:list={['brand-lockup', { 'brand-lockup--stacked': stacked }, className]}>
  <Logo class="brand-lockup__mark" />
  <span class="brand-lockup__text">
    <span class="brand-lockup__tagline">{BUSINESS.tagline}</span>
    <span class="brand-lockup__bar" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="brand-lockup__name">{BUSINESS.shortName}</span>
  </span>
</span>

<style>
  .brand-lockup { display: flex; align-items: center; gap: 10px; }
  .brand-lockup :global(.brand-lockup__mark) { width: 44px; flex: none; }
  .brand-lockup__text { display: grid; gap: 3px; font-family: var(--font-brand); }
  .brand-lockup__tagline {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .07em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--dim);
  }
  .brand-lockup__bar { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px; height: 2px; }
  .brand-lockup__bar i:nth-child(2) { background: var(--logo-blue); }
  .brand-lockup__bar i:nth-child(1), .brand-lockup__bar i:nth-child(3) { background: var(--logo-grey); }
  .brand-lockup__name { font-size: 14px; font-weight: 600; line-height: 1.1; color: var(--ink); }

  /* Footer: the full stacked lockup, the way the printed logo is built. */
  .brand-lockup--stacked { flex-direction: column; align-items: start; gap: 7px; width: 190px; }
  .brand-lockup--stacked :global(.brand-lockup__mark) { width: 190px; }
  .brand-lockup--stacked .brand-lockup__text { gap: 5px; justify-items: stretch; width: 100%; }
  .brand-lockup--stacked .brand-lockup__tagline { font-size: 14.5px; letter-spacing: .02em; }
  .brand-lockup--stacked .brand-lockup__bar { height: 5px; gap: 4px; }
  .brand-lockup--stacked .brand-lockup__name { font-size: 17.5px; white-space: nowrap; }

  @media (min-width: 900px) {
    .brand-lockup :global(.brand-lockup__mark) { width: 56px; }
    .brand-lockup__tagline { font-size: 10.5px; }
    .brand-lockup__name { font-size: 16.5px; }
    .brand-lockup--stacked :global(.brand-lockup__mark) { width: 190px; }
    .brand-lockup--stacked .brand-lockup__tagline { font-size: 15px; }
    .brand-lockup--stacked .brand-lockup__name { font-size: 18.5px; }
  }
</style>
