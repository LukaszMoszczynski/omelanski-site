---
import type { DutyGroup } from '../data/duties';
import NumberedList from './NumberedList.astro';

interface Props { label: string; groups: DutyGroup[] }
const { label, groups } = Astro.props;
---
<tabs-widget class="tabs" data-reveal>
  <div class="tabs__list" role="tablist" aria-label={label} hidden>
    <span class="tabs__indicator" aria-hidden="true"></span>
    {groups.map((g, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${g.id}`}
        aria-controls={`panel-${g.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >{g.label}</button>
    ))}
  </div>
  <div class="tabs__panels">
    {groups.map((g) => (
      <section class="tabs__panel" id={`panel-${g.id}`} aria-labelledby={`duty-${g.id}`}>
        <h3 id={`duty-${g.id}`}>{g.head}</h3>
        <NumberedList items={g.items} />
      </section>
    ))}
  </div>
</tabs-widget>

<script>
  import { gsap } from 'gsap';
  import { EASE_OUT, motionEnabled } from '../scripts/motion';

  class TabsWidget extends HTMLElement {
    private tabs: HTMLButtonElement[] = [];
    private panels: HTMLElement[] = [];
    private indicator: HTMLElement | null = null;
    private current = 0;
    private resizeObserver?: ResizeObserver;
    private initialised = false;

    connectedCallback() {
      if (this.initialised) return;
      const list = this.querySelector<HTMLElement>('[role="tablist"]');
      if (!list) return;
      this.initialised = true;
      this.tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      this.panels = this.tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
      this.indicator = list.querySelector<HTMLElement>('.tabs__indicator');
      this.panels.forEach((panel, i) => {
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', this.tabs[i].id);
        panel.tabIndex = 0;
      });
      list.hidden = false;
      // Panels are stacked in one grid cell once JS runs, so the section keeps the
      // height of the tallest panel and switching tabs never shifts the page.
      this.classList.add('is-ready');
      this.select(0, false, false);
      // Tabs wrap differently at other widths: keep the highlight on the selected tab.
      this.resizeObserver = new ResizeObserver(() => this.placeIndicator(false));
      this.resizeObserver.observe(list);
      list.addEventListener('click', (event) => {
        const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
        if (tab) this.select(this.tabs.indexOf(tab), false);
      });
      list.addEventListener('keydown', (event) => this.onKey(event));
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    /** Moves the highlight behind the selected tab; it slides when motion is on. */
    private placeIndicator(animate: boolean) {
      const tab = this.tabs[this.current];
      if (!this.indicator || !tab) return;
      const box = { x: tab.offsetLeft, y: tab.offsetTop, width: tab.offsetWidth, height: tab.offsetHeight };
      gsap.killTweensOf(this.indicator);
      if (animate && motionEnabled()) gsap.to(this.indicator, { ...box, duration: 0.35, ease: EASE_OUT });
      else gsap.set(this.indicator, box);
    }

    private onKey(event: KeyboardEvent) {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const current = this.tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current < 0) return;
      const last = this.tabs.length - 1;
      const next = {
        ArrowRight: current === last ? 0 : current + 1,
        ArrowLeft: current === 0 ? last : current - 1,
        Home: 0,
        End: last,
      }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      this.select(next, true);
    }

    private select(index: number, focus: boolean, animate = true) {
      const changed = index !== this.current;
      this.current = index;
      this.placeIndicator(animate);
      this.tabs.forEach((tab, i) => {
        const active = i === index;
        const panel = this.panels[i];
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        // Hidden with visibility, not `hidden`, so the stacked panel keeps its space.
        // `inert` + aria-hidden keep it out of the tab order and the accessibility tree.
        panel.toggleAttribute('inert', !active);
        panel.setAttribute('aria-hidden', String(!active));
        gsap.killTweensOf(panel);
        if (active && animate && changed && motionEnabled()) {
          gsap.fromTo(panel, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.3, ease: EASE_OUT, clearProps: 'transform,opacity' });
        } else {
          gsap.set(panel, { clearProps: 'transform,opacity' });
        }
      });
      if (focus) this.tabs[index].focus();
    }
  }
  if (!customElements.get('tabs-widget')) customElements.define('tabs-widget', TabsWidget);
</script>

<style>
  .tabs { display: block; }
  .tabs__list { position: relative; display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 18px; }
  /* The highlight behind the selected tab; the script slides it from tab to tab. */
  .tabs__indicator { position: absolute; top: 0; left: 0; width: 0; height: 0; border-radius: 2px; background: var(--accent); pointer-events: none; }
  .tabs__list[hidden] { display: none; }
  .tabs__list button {
    min-height: 36px;
    padding: 9px 13px;
    border: 0;
    border-radius: 2px;
    background: var(--wash);
    color: var(--mid);
    font: 600 12.5px var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .tabs__list button { position: relative; }
  .tabs__list button:hover:not([aria-selected='true']) { transform: translateY(-2px); }
  /* The selected tab shows the highlight behind it instead of its own background. */
  .tabs__list button[aria-selected='true'] { background: transparent; color: var(--on-accent); }
  /* Without JS every panel is readable, one after another. */
  .tabs__panel + .tabs__panel { margin-top: 24px; }
  .tabs__panel h3 { margin-bottom: 12px; font-size: 17px; line-height: 1.3; letter-spacing: -.01em; }

  /* With JS the panels share one grid cell: equal height, no jump. */
  .tabs.is-ready .tabs__panels { display: grid; }
  .tabs.is-ready .tabs__panel { grid-area: 1 / 1; margin: 0; }
  .tabs.is-ready .tabs__panel[inert] { visibility: hidden; }
  @media (min-width: 900px) {
    .tabs__list { gap: 8px; margin-bottom: 26px; }
    .tabs__list button { padding: 10px 18px; font-size: 13.5px; }
    .tabs__panel { display: grid; grid-template-columns: .55fr 1.45fr; gap: 44px; align-content: start; }
    .tabs__panel h3 { margin: 0; font-size: 23px; line-height: 1.25; letter-spacing: -.02em; }
  }
</style>
