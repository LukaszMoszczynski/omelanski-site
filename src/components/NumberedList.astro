---
interface Props { items: string[]; columns?: 1 | 2 }
const { items, columns = 2 } = Astro.props;
---
<ol role="list" class:list={['num-list', { 'num-list--two': columns === 2 }]}>
  {items.map((text, i) => (
    <li style={`--i: ${i}`}>
      <span class="num-list__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span>{text}</span>
    </li>
  ))}
</ol>

<style>
  .num-list { list-style: none; display: grid; }
  .num-list li { position: relative; display: flex; gap: 12px; padding: 11px 0; font-size: 14px; line-height: 1.5; color: var(--body); }
  /* The separator is a drawn line rather than a border, so it can draw itself from the left
     when its section arrives (.lines-waiting is set by src/scripts/reveal.ts and Tabs). */
  .num-list li::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line);
    transform-origin: left;
    transition: transform var(--dur-draw) var(--ease-out) calc(var(--i, 0) * var(--draw-step));
  }
  :global(.lines-waiting) .num-list li::before { transform: scaleX(0); transition: none; }
  @media print { .num-list li::before { transform: none !important; } }
  .num-list__n { flex: none; padding-top: 3px; font: 500 10.5px var(--font-mono); color: var(--accent-text); }
  @media (min-width: 900px) {
    /* Equal rows so the two columns line up even with different text lengths. */
    .num-list--two { grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; column-gap: 40px; }
    .num-list li { gap: 14px; padding: 13px 0; font-size: 14.5px; }
    .num-list__n { font-size: 11px; }
  }
</style>
