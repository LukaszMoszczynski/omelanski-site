---
import { Image } from 'astro:assets';
import { BUSINESS, MAPS_URL } from '../data/site';
import ExternalLink from './ExternalLink.astro';
import mapImage from '../assets/map-office.png';

interface Props { height: number; mobileHeight?: number }
const { height, mobileHeight = 170 } = Astro.props;
---
<div class="map-wrap" style={`--map-h: ${height}px; --map-mh: ${mobileHeight}px`}>
  <ExternalLink href={MAPS_URL} class="map">
    <Image
      class="map__img"
      src={mapImage}
      alt={`Mapa okolicy biura – ${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
      widths={[512, 1024]}
      sizes="(min-width: 900px) 520px, 100vw"
      loading="lazy"
    />
    <span class="map__bar">
      <span class="map__cta">Pokaż na mapie Google</span>
      <span class="map__addr">{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</span>
    </span>
  </ExternalLink>
  <p class="map__credit">
    Mapa: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap<span class="visually-hidden"> (otwiera się w nowej karcie)</span></a>
  </p>
</div>

<style>
  .map-wrap { display: grid; gap: 5px; }
  .map-wrap :global(.map) {
    position: relative;
    display: block;
    height: var(--map-mh);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color .2s ease;
  }
  .map-wrap :global(.map:hover) { border-color: var(--accent-border); }
  .map__img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  :global([data-theme='dark']) .map__img { filter: brightness(.88) saturate(.9); }
  .map__bar {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 1px;
    padding: 8px 10px;
    background: color-mix(in srgb, var(--surf) 88%, transparent);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .map__cta { font-weight: 600; font-size: 13.5px; color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .map__addr { font: 500 10.5px var(--font-mono); color: var(--dim); }
  .map__credit { font: 500 10px var(--font-mono); color: var(--dim); text-align: right; }
  .map__credit a { color: inherit; }
  @media (min-width: 900px) {
    .map-wrap :global(.map) { height: var(--map-h); }
    .map__cta { font-size: 14px; }
  }
</style>
