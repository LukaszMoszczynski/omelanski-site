---
import { BUSINESS, MAPS_URL } from '../data/site';
import ExternalLink from './ExternalLink.astro';

interface Props { height: number; mobileHeight?: number }
const { height, mobileHeight = 170 } = Astro.props;

// Same embed as the previous company site, pinned to the office address.
const EMBED_SRC =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2346.9765591101204!2d14.771303316170048!3d53.96768398011389!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47aa8418b6c96f21%3A0x34f0fdab97370e0!2sJedno%C5%9Bci%20Narodowej%201%2F4%2C%2072-400%20Kamie%C5%84%20Pomorski!5e0!3m2!1spl!2spl!4v1572968282498!5m2!1spl!2spl';
---
<div class="map-wrap" style={`--map-h: ${height}px; --map-mh: ${mobileHeight}px`}>
  <iframe
    class="map__frame"
    src={EMBED_SRC}
    title={`Mapa Google – ${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <p class="map__link">
    <ExternalLink href={MAPS_URL}>Pokaż na mapie Google</ExternalLink>
  </p>
</div>

<style>
  .map-wrap { display: grid; gap: 6px; }
  .map__frame {
    display: block;
    width: 100%;
    height: var(--map-mh);
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--wash);
  }
  /* Tabbing into the map moves focus inside the frame's own document, so the frame element
     matches :focus-within rather than :focus — and gets no ring from the browser by default. */
  .map__frame:focus,
  .map__frame:focus-within { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .map__link { font-size: 13.5px; font-weight: 600; text-align: right; }
  .map__link :global(a) { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 900px) {
    .map__frame { height: var(--map-h); }
    .map__link { font-size: 14px; }
  }
</style>
