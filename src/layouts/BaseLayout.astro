---
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-500.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-ext-400.css';
import '@fontsource/source-serif-4/latin-ext-500.css';
import '@fontsource/source-serif-4/latin-ext-600.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/jetbrains-mono/latin-ext-500.css';
import '@fontsource/jetbrains-mono/latin-ext-700.css';
// Barlow is the logo's own typeface: used only for the wordmark, so the brand
// keeps its look whatever font the rest of the site uses.
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-ext-600.css';
import serifLatin400 from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import serifLatin600 from '@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url';
import serifLatinExt400 from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-400-normal.woff2?url';
import serifLatinExt600 from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-600-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { fullTitle, type PageMeta } from '../data/pages';
import { breadcrumbJsonLd, businessJsonLd } from '../lib/jsonld';
import { absoluteUrl, url } from '../lib/url';

// PREVIEW=1 builds (the GitHub Pages copy shown to the client) stay out of search results,
// so the preview never competes with the real site.
const isPreview = process.env.PREVIEW === '1';

interface Props { page: PageMeta; noindex?: boolean }
const { page, noindex: noindexProp = false } = Astro.props;
const noindex = noindexProp || isPreview;
const title = fullTitle(page);
const canonical = absoluteUrl(page.path);
const ogImage = absoluteUrl('/og.jpg?v=2');
const breadcrumb = noindex ? null : breadcrumbJsonLd(absoluteUrl, page);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={page.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6f0e6" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preload" href={serifLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatinExt400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatinExt600} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Radosław Omelański – Zarządzanie Nieruchomościami" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Logo Radosław Omelański – Zarządzanie Nieruchomościami i widok Kamienia Pomorskiego" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        // Light unless the visitor picked dark; the OS preference is not consulted.
        if (theme !== 'dark') theme = 'light';
        root.dataset.theme = theme;
        if (theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#101a22');
        // Motion (src/scripts/motion.ts): marked elements are hidden by CSS until the
        // module starts. Reduced motion never gets the class; a module that never
        // starts loses it after 2 s, so content can't stay hidden.
        var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (motion) {
          root.classList.add('motion');
          window.setTimeout(function () {
            if (!root.classList.contains('motion-ready')) root.classList.remove('motion');
          }, 2000);
        }
        // Astro restores the scroll position itself (also after a reload): keep that instant
        // until the page has loaded (see astro:page-load below).
        root.classList.add('is-swapping');
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.theme = root.dataset.theme;
          // Astro copies the new page's <html> attributes, so the motion state is carried over.
          if (root.classList.contains('motion-ready')) event.newDocument.documentElement.classList.add('motion');
          // Restoring the scroll position (Back) or jumping to an anchor on the new page must be
          // instant: with smooth scrolling it would glide from the top and could be cut short.
          event.newDocument.documentElement.classList.add('is-swapping');
          // Not the first page any more: the CSS opening sequence stays off (intro.ts fades in).
          event.newDocument.documentElement.classList.add('is-returning');
          var meta = event.newDocument.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', root.dataset.theme === 'dark' ? '#101a22' : '#f6f0e6');
        });
        document.addEventListener('astro:page-load', function () {
          window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () { root.classList.remove('is-swapping'); });
          });
        });
      })();
    </script>
    <ClientRouter />
    <JsonLd data={businessJsonLd(absoluteUrl)} />
    {breadcrumb && <JsonLd data={breadcrumb} />}
    <link rel="alternate" type="text/plain" href={url('/llms.txt')} title="llms.txt" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import '../scripts/motion';
      import '../scripts/intro';
      import '../scripts/reveal';
      import '../scripts/page-transition';
      import '../scripts/logo';
      // After client-side navigation move focus to the new page's h1.
      // ClientRouter's built-in announcer reads the new title.
      // `astro:after-swap` only fires on client navigation, so the initial load is never affected
      // regardless of when this module runs.
      let swapped = false;
      document.addEventListener('astro:after-swap', () => { swapped = true; });
      document.addEventListener('astro:page-load', () => {
        if (!swapped) return;
        swapped = false;
        if (location.hash) return;
        document.querySelector<HTMLElement>('main h1')?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
