---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapLink from '../components/MapLink.astro';
import PageIntro from '../components/PageIntro.astro';
import { PAGES } from '../data/pages';
import { AFTER_HOURS, BUSINESS, CONTACT } from '../data/site';
import { telHref } from '../lib/phone';
---
<BaseLayout page={PAGES.contact}>
  <PageIntro eyebrow="Biuro w Kamieniu Pomorskim" title="Kontakt" lead="Sprawy bieżące najszybciej załatwimy telefonicznie w godzinach pracy biura. Awarie po godzinach — bezpośrednio do właściwego pogotowia." />
  <div class="contact">
    <section class="contact__main" aria-labelledby="fast-title">
      <h2 id="fast-title" data-reveal>Najszybszy kontakt</h2>
      <ul class="cards" role="list">
        <li data-reveal>
          <a class="card card--primary" href={telHref(CONTACT.phone)}>
            <span><span class="card__label">Telefon</span><span class="card__value">{CONTACT.phone}</span></span>
            <span class="card__action">Zadzwoń <span class="card__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li data-reveal>
          <a class="card" href={`mailto:${CONTACT.email}`}>
            <span><span class="card__label">E-mail</span><span class="card__value">{CONTACT.email}</span></span>
            <span class="card__action card__action--accent">Napisz <span class="card__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li data-reveal>
          <a class="card" href={telHref(CONTACT.landline)}>
            <span><span class="card__label">Telefon stacjonarny</span><span class="card__value">{CONTACT.landline}</span></span>
            <span class="card__hint">w godzinach pracy biura <span class="card__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ul>
      <h2 class="after__title" id="after-title" data-reveal>Awaria po godzinach pracy biura</h2>
      <ul class="after" role="list" aria-labelledby="after-title">
        {AFTER_HOURS.map((a) => (
          <li data-reveal>
            <a href={telHref(a.number)} aria-label={`${a.label}: ${a.number}`}>
              <span>{a.label}</span><span class="after__num">{a.number}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="contact__office" aria-labelledby="office-title">
      <h2 id="office-title" data-reveal>Dane biura</h2>
      <dl class="facts" data-reveal>
        <div><dt>Adres</dt><dd>{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</dd></div>
        <div><dt>Telefon</dt><dd>tel. stacjonarny: {CONTACT.landline}<br />tel.: {CONTACT.phone}</dd></div>
        <div><dt>E-mail</dt><dd><a class="link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
        <div><dt>Godziny otwarcia</dt><dd>{CONTACT.hoursDays}<br /><strong>{CONTACT.hoursTime}</strong></dd></div>
      </dl>
      <MapLink />
    </section>
  </div>
</BaseLayout>

<style>
  .contact__main, .contact__office { padding: 24px var(--gutter); }
  .contact__office { background: var(--surf); border-top: 1px solid var(--line); }
  h2 { margin-bottom: 16px; font-size: 20px; }
  .cards { list-style: none; display: grid; gap: 9px; margin-bottom: 26px; }
  .card { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 18px; background: var(--surf); border: 1px solid var(--line); border-radius: 3px; color: var(--ink); text-decoration: none; transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease; }
  /* Hover: the card lifts onto a soft shadow, a blue bar grows on its left edge and the
     arrow moves on, so it's clear the whole card is the link. */
  .card { position: relative; isolation: isolate; overflow: hidden; }
  .card::before { content: ''; position: absolute; inset: 0 auto 0 0; z-index: -1; width: 3px; background: var(--accent); transform: scaleY(0); transition: transform var(--dur) var(--ease-out); }
  .card:hover { border-color: var(--accent-border); transform: translateY(-3px); box-shadow: 0 14px 30px -18px var(--shadow); }
  .card:hover::before { transform: scaleY(1); }
  .card:hover .card__label { color: var(--accent-text); }
  .card:active { transform: translateY(-1px); transition-duration: var(--dur-press); }
  .card__arrow { display: inline-block; transition: transform var(--dur) var(--ease-out); }
  .card:hover .card__arrow { transform: translateX(5px); }
  .card--primary::before { inset: 0; width: auto; background: rgba(0, 0, 0, .18); transform: scaleX(0); transform-origin: left; }
  .card--primary:hover::before { transform: scaleX(1); }
  .card--primary:hover .card__label { color: var(--on-accent); }
  .card--primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .card__label { display: block; margin-bottom: 5px; font: 500 10.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); transition: color var(--dur-fast) ease; }
  .card--primary .card__label { color: var(--on-accent); opacity: .85; }
  .card__value { font-size: 17px; font-weight: 600; overflow-wrap: anywhere; }
  .card__action { flex: none; font-size: 14px; font-weight: 600; }
  .card__action--accent { color: var(--accent-text); }
  .card__hint { font-size: 13px; color: var(--dim); text-align: right; }
  .after__title { margin-bottom: 14px; font-size: 18px; }
  .after { list-style: none; font-size: 15px; line-height: 1.7; color: var(--body); }
  .after li { border-top: 1px solid var(--line); }
  .after li:last-child { border-bottom: 1px solid var(--line); }
  /* Hover: a light band sweeps in behind the row, the name steps right, the number darkens. */
  .after a { position: relative; isolation: isolate; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 13px 0; color: inherit; text-decoration: none; }
  .after a::before { content: ''; position: absolute; inset: 0 -10px; z-index: -1; border-radius: 2px; background: var(--accent-wash); transform: scaleX(0); transform-origin: left; transition: transform var(--dur) var(--ease-out); }
  .after a:hover::before { transform: scaleX(1); }
  .after a > span:first-child { transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease; }
  .after a:hover > span:first-child { color: var(--ink); transform: translateX(8px); }
  .after__num { font: 500 14px var(--font-mono); color: var(--accent-text); transition: transform var(--dur) var(--ease-out); }
  .after a:hover .after__num { color: var(--ink); transform: translateX(-8px); }
  .facts { display: grid; gap: 2px; margin: 0 0 18px; font-size: 14.5px; line-height: 1.75; color: var(--body); }
  .facts div { padding: 13px 0; border-top: 1px solid var(--line); }
  .facts div:last-child { border-bottom: 1px solid var(--line); }
  .facts dt { margin-bottom: 5px; font: 500 10.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
  .facts dd { margin: 0; }
  .facts strong { color: var(--ink); }
  @media (min-width: 900px) {
    .contact { display: grid; grid-template-columns: .58fr .42fr; max-width: var(--max); margin-inline: auto; }
    .contact__main { padding: 38px 40px 44px var(--gutter); border-right: 1px solid var(--line); }
    .contact__office { padding: 38px var(--gutter) 44px 40px; border-top: 0; }
    h2 { margin-bottom: 22px; font-size: 22px; }
    .card { padding: 20px 22px; }
    .card--primary:hover { box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .5); }
    .card__label { font-size: 11px; }
    .card__value { font-size: 19px; }
    .facts { font-size: 15px; }
    .facts div { padding: 14px 0; }
    .facts dt { font-size: 11px; }
  }
</style>
