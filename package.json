{
  "name": "omelanska-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "test:base": "node scripts/test-base.mjs",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:links && npm run test:base && npm run test:e2e",
    "og": "node scripts/make-og.mjs",
    "map": "node scripts/make-map.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/barlow": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "linkinator": "^8.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
